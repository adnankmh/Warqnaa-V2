APP_NAME="Warqnaa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8007
WARQNA_VERSION=1.1.2
WARQNA_BUILD=302
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SOCKET_HOST=127.0.0.1
SOCKET_PORT=4000
ADMIN_USERNAME=Adnan
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
DELEGATED_ADMIN_EMAIL=abd@warqna.local
DELEGATED_ADMIN_PASSWORD=

# Flutter Web / GitHub Pages API access. Use * for testing, then restrict to your domains.
CORS_ALLOWED_ORIGINS=*
FRONTEND_URL=http://127.0.0.1:8088

# R12 Competitive Arena. Rating and rewards remain server-authoritative.
WARQNAA_RANKED_INITIAL_RATING=1000
WARQNAA_RANKED_QUEUE_TIMEOUT_MINUTES=15
WARQNAA_RANKED_SEARCH_WINDOW_INITIAL=100
WARQNAA_RANKED_SEARCH_WINDOW_MAX=500
WARQNAA_RANKED_ABANDON_PENALTY=35

# Voice rooms (WebRTC). STUN is enough for local testing; production should use TURN.
VOICE_STUN_URLS=stun:stun.l.google.com:19302
VOICE_TURN_URLS=
VOICE_TURN_USERNAME=
VOICE_TURN_CREDENTIAL=

# Production readiness
SUPPORT_EMAIL=support@warqna.example
SUPPORT_URL=/legal/support
PRIVACY_URL=/legal/privacy
TERMS_URL=/legal/terms
ACCOUNT_DELETION_GRACE_DAYS=30
ALLOW_LOCAL_DEMO_MODE=false
TOKEN_TRANSFER_FEE_PERCENT=10

HEALTH_SHOW_COUNTS=true

# Social sign-in. Create apps in each provider console and register the exact callback URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/social/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/auth/social/facebook/callback
FACEBOOK_GRAPH_VERSION=v22.0
APPLE_SERVICE_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=${APP_URL}/auth/social/apple/callback

# Firebase Cloud Messaging HTTP v1 (optional but required for alerts while app is closed)
PUSH_NOTIFICATIONS_ENABLED=true
FIREBASE_PROJECT_ID=
# Recommended: base64-encode the complete Firebase service-account JSON and place it here.
FIREBASE_SERVICE_ACCOUNT_B64=
# Alternative options (use one only):
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_HTTP_TIMEOUT=12
FIREBASE_ANDROID_CHANNEL_ID=warqna_messages

# R10 asset delivery (local|hybrid|remote). Leave CDN URL blank for local development.
WARQNA_ASSET_MODE=hybrid
WARQNA_ASSET_CDN_URL=
WARQNA_ASSET_MANIFEST_TTL=21600
WARQNA_DATA_SAVER_DEFAULT=false

# R10.1 commerce / ads (no secrets are committed)
WARQNAA_COMMERCE_ENABLED=true
WARQNAA_COMMERCE_SANDBOX=false
WARQNAA_GOOGLE_PLAY_BILLING=true
WARQNAA_APPLE_IAP=true
WARQNAA_WEB_PAYMENTS=true

# R11 Social World safety limits. Feature switches and retention days remain
# editable from Admin Social World and are stored in site_settings.
WARQNAA_REPLAY_MAX_FRAMES=600
WARQNAA_SPECTATOR_STALE_SECONDS=30
